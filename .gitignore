# 依赖
node_modules/

# 注意：lib/ 是编译产物，但【必须提交】
# 原因：package.json 的 main 指向 lib/index.js，而 DSH 装插件时直接加载它，
# 不会自己跑 tsc。忽略 lib/ 会导致别人装完没有任何可执行代码，加载即失败。
# 所以这里【故意不忽略】 lib/。

# 测试运行产生的临时工作区（不要提交）
论文/
求解/
题目/
数据/

# LaTeX 编译中间文件
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# 系统文件
.DS_Store
Thumbs.db
~$*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
